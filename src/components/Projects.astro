---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;

// Button labels for each link type in config.ts
const linkLabels: Record<string, string> = {
  demo: "Demo",
  website: "Website",
  video: "Video",
  code: "Code",
};

// Tabler icon paths (24x24, stroke) for each link type
const linkIcons: Record<string, string> = {
  demo: '<path d="M4 13a8 8 0 0 1 7 7a6 6 0 0 0 3 -5a9 9 0 0 0 6 -8a3 3 0 0 0 -3 -3a9 9 0 0 0 -8 6a6 6 0 0 0 -5 3" /><path d="M7 14a6 6 0 0 0 -3 6a6 6 0 0 0 6 -3" /><path d="M15 9m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />',
  website:
    '<path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" /><path d="M3.6 9h16.8" /><path d="M3.6 15h16.8" /><path d="M11.5 3a17 17 0 0 0 0 18" /><path d="M12.5 3a17 17 0 0 1 0 18" />',
  video:
    '<path d="M2 8a4 4 0 0 1 4 -4h12a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-12a4 4 0 0 1 -4 -4v-8z" /><path d="M10 9l5 3l-5 3z" />',
  code: '<path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />',
};

// Filter by field, shown in this order (only the ones that have projects)
const fieldOrder = ["Machine Learning", "Statistics", "Data Visualization", "Hackathons"];
const presentFields = fieldOrder.filter((f) =>
  siteConfig.projects?.some((p: any) => p.fields?.includes(f))
);
---

{
  hasProjects && (
    <section id="projects" class="max-w-5xl mx-auto p-8 sm:p-12 lg:p-16">
      <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-bold text-gray-900">
        Projects
      </h2>
      <div
        class="w-[75px] h-[5px] mt-2 rounded-full"
        style={`background-color: ${siteConfig.accentColor}`}
      />

      {presentFields.length > 1 && (
        <div
          id="project-filters"
          class="flex flex-wrap gap-2 mt-8"
          style={`--accent-color: ${siteConfig.accentColor}`}
        >
          <button type="button" class="filter-btn active" data-filter="all">
            All
          </button>
          {presentFields.map((f) => (
            <button type="button" class="filter-btn" data-filter={f}>
              {f}
            </button>
          ))}
        </div>
      )}

      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {siteConfig.projects.map((project: any, index: number) => (
          <div class="project-item" data-fields={(project.fields ?? []).join("|")}>
            <div
              class="card-fx h-full flex flex-col p-4 bg-[#ffffff] rounded-xl border border-[#d3deea]"
              style={`--accent-color: ${siteConfig.accentColor}`}
            >
              <div class="flex flex-wrap items-center gap-2">
                <span
                  class="text-xs font-mono"
                  style={{ color: siteConfig.accentColor }}
                >
                  0{index + 1}
                </span>
                {project.type && (
                  <span
                    class="whitespace-nowrap px-2 py-0.5 rounded-full text-xs font-medium font-mono border"
                    style={`color: ${siteConfig.accentColor}; border-color: ${siteConfig.accentColor}55; background-color: ${siteConfig.accentColor}12`}
                  >
                    {project.context ? `${project.type} · ${project.context}` : project.type}
                  </span>
                )}
              </div>

              <h3 class="mt-3 text-lg sm:text-xl font-bold text-gray-900">
                {project.name}
              </h3>

              {(project.date || project.team) && (
                <p class="mt-1 text-xs text-gray-500 font-mono">
                  {[project.date, project.team ? (project.team === 1 ? "Solo" : `Team of ${project.team}`) : null]
                    .filter(Boolean)
                    .join(" · ")}
                </p>
              )}

              <p class="mt-3 text-sm leading-relaxed text-gray-600">
                {project.description}
              </p>

              {project.skills && project.skills.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-1.5">
                  {project.skills.map((skill: string) => (
                    <span
                      class="px-2 py-1 rounded-md text-xs font-medium font-mono text-gray-700"
                      style={`background-color: ${siteConfig.accentColor}14`}
                    >
                      {skill}
                    </span>
                  ))}
                </div>
              )}

              {project.links && project.links.length > 0 && (
                <div class="mt-auto pt-5 flex flex-wrap gap-2">
                  {project.links.map((link: any, i: number) => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={linkLabels[link.type] ?? link.type}
                      title={linkLabels[link.type] ?? link.type}
                      class={i === 0 ? "link-btn link-icon link-btn-solid" : "link-btn link-icon"}
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                        set:html={linkIcons[link.type] ?? linkIcons.demo}
                      />
                    </a>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>
  )
}

<script>
  const bar = document.getElementById("project-filters");
  if (bar) {
    const buttons = bar.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const items = document.querySelectorAll<HTMLElement>(".project-item");
    buttons.forEach((btn) =>
      btn.addEventListener("click", () => {
        const f = btn.dataset.filter;
        buttons.forEach((b) => b.classList.toggle("active", b === btn));
        items.forEach((el) => {
          const show = f === "all" || (el.dataset.fields ?? "").split("|").includes(f ?? "");
          el.hidden = !show;
        });
      })
    );
  }
</script>
