---
import { siteConfig } from "../config";
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{
  hasEducation && (
    <section id="education" class="max-w-5xl mx-auto p-8 sm:p-12 lg:p-16">
      <div>
        <div class="flex flex-col gap-8">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-bold text-gray-900">
              Education
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-8">
              {siteConfig.education.map((edu: any) => (
                <div class="card-fx bg-white rounded-lg shadow-sm border border-[#dae5ef] p-4 sm:p-5 md:p-6"
                style={`--accent-color: ${siteConfig.accentColor}`}>
                  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between sm:gap-8">
                    <div>
                      <h3 class="text-lg sm:text-xl font-semibold text-gray-900">
                        {edu.degree}
                      </h3>
                      <p
                        class="text-base sm:text-lg"
                        style={`color: ${siteConfig.accentColor}`}
                      >
                        {edu.school}
                      </p>
                      {edu.honors && (
                        <p
                          class="mt-1 text-sm font-medium"
                          style={`color: ${siteConfig.accentColor}`}
                        >
                          {edu.honors}
                        </p>
                      )}
                      {edu.gpa && (
                        <p class="mt-1 text-xs sm:text-sm text-gray-600 font-mono">
                          GPA {edu.gpa}
                        </p>
                      )}
                    </div>
                    <span class="text-xs sm:text-sm text-gray-500 font-mono mt-2 sm:mt-1.5 sm:shrink-0 sm:whitespace-nowrap">
                      {edu.dateRange}
                    </span>
                  </div>

                  {edu.achievements && edu.achievements.length > 0 && (
                  <ul class="space-y-2 mt-4">
                    {edu.achievements.map((achievement) => (
                      <li class="flex items-start">
                        <span class="inline-block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 mr-3 flex-shrink-0" />
                        <span class="text-sm sm:text-base text-gray-600">
                          {achievement}
                        </span>
                      </li>
                    ))}
                  </ul>
                  )}

                  {edu.coursework && edu.coursework.length > 0 && (
                    <div class="mt-4">
                      <p class="text-xs uppercase tracking-widest text-gray-500">
                        Relevant coursework
                      </p>
                      <div class="mt-2 flex flex-wrap gap-1.5">
                        {edu.coursework.map((c: string) => (
                          <span
                            class="px-2.5 py-1 rounded-md text-xs sm:text-sm"
                            style={`color: ${siteConfig.accentColor}; background-color: ${siteConfig.accentColor}12`}
                          >
                            {c}
                          </span>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
